{
  "name": "sdd-planner-tools",
  "private": true,
  "type": "module",
  "description": "Замеры и гейт качества кода sdd-lint для того, кто правит sdd-planner. Пользователям расширения не нужны: MCP-сервер запускается голым node.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cd .. && node --test tests/*.test.mjs",
    "metrics": "node metrics/report.mjs",
    "metrics:fast": "node metrics/report.mjs --no-coverage",
    "gate": "node metrics/report.mjs --gate",
    "baseline": "node metrics/report.mjs --baseline",
    "lcov": "cd .. && mkdir -p coverage && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='skills/**' --test-reporter=dot --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "ub:gate": "node metrics/ub-gate.mjs",
    "ub:baseline": "node metrics/ub-gate.mjs --baseline"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "eslint": "10.1.0",
    "typescript": "6.0.2"
  }
}
